on tileForChar(ch: string): Image {\n    switch (ch) {\n        case \"G\": return T_GRASS\n        case \"D\": return T_DIRT\n        case \"H\": return T_HEATHER\n        case \"R\": return T_ROCK_TOP\n        case \"r\": return T_ROCK\n        case \"=\": return T_ROAD_TOP\n        case \"#\": return T_ROAD\n        case \"K\": return T_MARSH_TOP\n        case \"k\": return T_MUD\n        case \"B\": return T_BRAMBLE\n        case \"|\": return T_TRUNK\n        case \"^\": return T_LEAVES\n        case \"f\": return T_FERN\n        case \"~\": return T_WATER_A\n        case \"w\": return T_DEEP_WATER\n        case \"*\": return T_STAR_A\n    }\n    return TRANSPARENT_TILE\n}\n\n// -----------------------------------------------------------------------------\n//  Game state\n// -----------------------------------------------------------------------------\nconst PLAYER_SPEED = 85\nconst JUMP_SPEED = -235\nconst GRAVITY = 520\n\nlet player: Sprite = null\nlet currentLevel = 0\nlet levelBusy = true\nlet mapCols = 0\nlet mapRows = 0\nlet foesLeft = 0\nlet facing = 1\nlet attackUntil = 0\nlet attackReady = 0\nlet hurtUntil = 0\nlet invulnUntil = 0\nlet safeX = 0\nlet safeY = 0\nlet nextMonster = 0\nlet monsterWarned = false\nlet monsterDir = -1\nlet lockedMsgAt = 0\nlet boss: Sprite = null\nlet farLayer: Image = null\nlet nearLayer: Image = null\n\n// Small helpers for storing per-sprite values\nfunction getNum(s: Sprite, key: string): number { const v = s.data[key]; return v ? v : 0 }\nfunction setNum(s: Sprite, key: string, v: number) { s.data[key] = v }\nfunction getFlag(s: Sprite, key: string): boolean { return !!s.data[key] }\nfunction setFlag(s: Sprite, key: string, v: boolean) { s.data[key] = v }\nfunction getStr(s: Sprite, key: string): string { const v = s.data[key]; return v ? v : \"\" }\nfunction setStr(s: Sprite, key: string, v: string) { s.data[key] = v }\n\n// Restart an animation only when it actually changes.\nfunction setAnim(s: Sprite, key: string, frames: Image[], interval: number, loop: boolean) {\n    if (getStr(s, \"anim\") == key) return\n    setStr(s, \"anim\", key)\n    animation.runImageAnimation(s, frames, interval, loop)\n}\n\nfunction sfx(m: music.Melody) {\n    music.play(music.melodyPlayable(m), music.PlaybackMode.InBackground)\n}\n\nfunction tileIs(col: number, row: number, t: Image): boolean {\n    if (col < 0 || row < 0 || col >= mapCols || row >= mapRows) return false\n    return tiles.tileAtLocationEquals(tiles.getTileLocation(col, row), t)\n}\n\nfunction isWallAt(col: number, row: number): boolean {\n    if (col < 0 || col >= mapCols) return true\n    if (row < 0 || row >= mapRows) return false\n    return tiles.tileAtLocationIsWall(tiles.getTileLocation(col, row))\n}\n\nfunction inWater(s: Sprite): boolean {\n    const col = Math.floor(s.x / 16)\n    const row = Math.floor((s.bottom - 5) / 16)\n    return tileIs(col, row, T_WATER_A) || tileIs(col, row, T_WATER_B) || tileIs(col, row, T_DEEP_WATER)\n}\n\nfunction fellOut(s: Sprite): boolean {\n    return s.bottom >= mapRows * 16 - 2\n}\n\n// Put a sprite so its feet rest on the bottom of the given tile.\nfunction placeOnFloor(s: Sprite, col: number, row: number) {\n    s.x = col * 16 + 8\n    s.bottom = row * 16 + 16\n}\n\n// -----------------------------------------------------------------------------\n//  Parallax backgrounds (drawn behind the tilemap)\n// -----------------------------------------------------------------------------\nlet rngSeed = 1\nfunction rand(n: number): number {\n    rngSeed = (rngSeed * 1103515245 + 12345) & 0x7fffffff\n    return rngSeed % n\n}\n\nfunction wrapCircle(img: Image, x: number, y: number, r: number, c: number) {\n    img.fillCircle(x, y, r, c)\n    img.fillCircle(x - img.width, y, r, c)\n    img.fillCircle(x + img.width, y, r, c)\n}\n\nfunction pine(img: Image, x: number, base: number, h: number, c: number) {\n    for (let i = 0; i < h; i++) {\n        const half = Math.idiv(i, 2) + 1\n        for (const ox of [0, -img.width, img.width]) {\n            img.drawLine(x + ox - half, base - h + i, x + ox + half, base - h + i, c)\n        }\n    }\n    img.fillRect(x - 1, base, 3, img.height - base, c)\n}\n\nfunction buildBackground(theme: number) {\n    rngSeed = 7 + theme * 31\n    farLayer = image.create(160, 120)\n    nearLayer = image.create(160, 120)\n    if (theme == 0) {            // forest day: clouds + green treeline\n        scene.setBackgroundColor(9)\n        for (let i = 0; i < 6; i++) {\n            const x = rand(160), y = 10 + rand(30)\n            wrapCircle(farLayer, x, y, 6 + rand(4), 1)\n            wrapCircle(farLayer, x + 8, y + 2, 5 + rand(3), 1)\n            wrapCircle(farLayer, x - 7, y + 3, 4, 1)\n        }\n        for (let x = 0; x < 160; x += 9) wrapCircle(nearLayer, x, 70 + rand(10), 10 + rand(5), 6)\n        nearLayer.fillRect(0, 78, 160, 42, 6)\n    } else if (theme == 1) {     // moor: clouds + rolling hills\n        scene.setBackgroundColor(9)\n        for (let i = 0; i < 5; i++) {\n            const x = rand(160), y = 8 + rand(25)\n            wrapCircle(farLayer, x, y, 5 + rand(4), 1)\n            wrapCircle(farLayer, x + 7, y + 1, 4 + rand(3), 1)\n        }\n        for (let x = 0; x < 160; x++) {\n            const h = 70 + Math.round(8 * Math.sin(x * Math.PI / 40) + 4 * Math.sin(x * Math.PI / 16))\n            nearLayer.drawLine(x, h, x, 119, 6)\n            if (h + 3 < 120) nearLayer.setPixel(x, h + 3 + (x % 3), 7)\n        }\n    } else if (theme == 2) {     // Thunderpath at dusk: sun, Twoleg buildings\n        scene.setBackgroundColor(3)\n        farLayer.fillRect(0, 0, 160, 25, 0xa)\n        farLayer.fillRect(0, 25, 160, 15, 0xb)\n        farLayer.fillCircle(120, 58, 16, 5)\n        farLayer.fillCircle(120, 58, 11, 4)\n        let x = 0\n        while (x < 160) {\n            const w = 12 + rand(14), h = 25 + rand(30)\n            nearLayer.fillRect(x, 95 - h, w, h + 25, 0xc)\n            for (let wy = 95 - h + 4; wy < 90; wy += 7) {\n                for (let wx = x + 3; wx < x + w - 3; wx += 5) {\n                    if (rand(3) == 0) nearLayer.fillRect(wx, wy, 2, 3, 5)\n                }\n            }\n            x += w + 2 + rand(8)\n        }\n    } else {                     // ShadowClan night: stars, moon, pines\n        scene.setBackgroundColor(15)\n        for (let i = 0; i < 40; i++) farLayer.setPixel(rand(160), rand(70), rand(4) == 0 ? 5 : 1)\n        farLayer.fillCircle(40, 25, 10, 1)\n        farLayer.fillCircle(44, 22, 9, 15)\n        for (let x = 0; x < 160; x += 11) pine(nearLayer, x + rand(5), 85 + rand(8), 30 + rand(25), 0xc)\n    }\n}\n\nscene.createRenderable(-10, function (target: Image, camera: scene.Camera) {\n    if (!farLayer) return\n    const left = scene.cameraProperty(CameraProperty.Left)\n    const top = scene.cameraProperty(CameraProperty.Top)\n    drawWrapped(target, farLayer, left * 0.15, -top * 0.1)\n    drawWrapped(target, nearLayer, left * 0.4, 10 - top * 0.3)\n})\n\nfunction drawWrapped(target: Image, layer: Image, offset: number, y: number) {\n    let x = -(Math.floor(offset) % layer.width)\n    while (x < 160) {\n        target.drawTransparentImage(layer, x, Math.floor(y))\n        x += layer.width\n    }\n}\n\n// HUD: level name, foes left and the boss's health\nscene.createRenderable(90, function (target: Image, camera: scene.Camera) {\n    if (levelBusy) return\n    const L = LEVELS[currentLevel]\n    const msg = foesLeft > 0 ? \"Foes: \" + foesLeft : \"Go to the star!\"\n    target.fillRect(0, 111, 160, 9, 15)\n    target.print(L.name, 2, 112, 5, image.font5)\n    target.print(msg, 158 - msg.length * 6, 112, 1, image.font5)\n    if (boss && !getFlag(boss, \"dead\") && getFlag(boss, \"spotted\")) {\n        const t = CAT_TYPES[getNum(boss, \"type\")]\n        const hp = getNum(boss, \"hp\")\n        target.print(t.name, 40, 12, 1, image.font5)\n        target.fillRect(40, 19, 80, 4, 15)\n        target.fillRect(41, 20, Math.floor(78 * hp / t.hp), 2, 2)\n    }\n})\n\n// -----------------------------------------------------------------------------\n//  Building a level\n// -----------------------------------------------------------------------------\nfunction loadLevel(n: number) {\n    levelBusy = true\n    currentLevel = n\n    const L = LEVELS[n]\n    for (const k of [SpriteKind.Enemy, SpriteKind.Food, SpriteKind.Monster, SpriteKind.Fallen, SpriteKind.Warning]) {\n        sprites.destroyAllSpritesOfKind(k)\n    }\n    boss = null\n    foesLeft = 0\n    nextMonster = 0\n    monsterWarned = false\n\n    mapRows = L.map.length\n    mapCols = 0\n    for (const row of L.map) mapCols = Math.max(mapCols, row.length)\n\n    // A real MakeCode tilemap built from the ASCII map, using our custom tiles.\n    const data = control.createBuffer(4 + mapCols * mapRows)\n    data.setNumber(NumberFormat.UInt16LE, 0, mapCols)\n    data.setNumber(NumberFormat.UInt16LE, 2, mapRows)\n    const tileset: Image[] = [TRANSPARENT_TILE, T_WATER_B, T_STAR_B]\n    for (let i = 0; i < TILE_CHARS.length; i++) tileset.push(tileForChar(TILE_CHARS.charAt(i)))\n    tiles.setCurrentTilemap(tiles.createTilemap(data, image.create(mapCols, mapRows), tileset, TileScale.Sixteen))\n\n    let startCol = 1, startRow = 1\n    for (let r = 0; r < mapRows; r++) {\n        const row = L.map[r]\n        for (let c = 0; c < mapCols; c++) {\n            const ch = c < row.length ? row.charAt(c) : \".\"\n            const loc = tiles.getTileLocation(c, r)\n            if (TILE_CHARS.indexOf(ch) >= 0) {\n                tiles.setTileAt(loc, tileForChar(ch))\n                tiles.setWallAt(loc, WALL_CHARS.indexOf(ch) >= 0)\n            } else if (ch == \"@\") {\n                startCol = c; startRow = r\n            } else if (ch == \"m\") {\n                spawnMouse(c, r)\n            } else if (ch >= \"1\" && ch <= \"5\") {\n                spawnCat(ch.charCodeAt(0) - 49, c, r)\n            }\n        }\n    }\n\n    buildBackground(L.theme)\n\n    if (!player) {\n        player = sprites.create(FIREHEART.idle[0][0], SpriteKind.Player)\n        player.ay = GRAVITY\n        player.z = 10\n        scene.cameraFollowSprite(player)\n    }\n    placeOnFloor(player, startCol, startRow)\n    player.vx = 0\n    player.vy = 0\n    facing = 1\n    safeX = player.x\n    safeY = player.y\n    setStr(player, \"anim\", \"\")\n\n    game.showLongText(L.name + \"\\n\\n\" + L.story, DialogLayout.Center)\n    levelBusy = false\n}\n\nfunction spawnCat(typeIndex: number, col: number, row: number) {\n    const t = CAT_TYPES[typeIndex]\n    const e = sprites.create(t.skin.idle[1][0], SpriteKind.Enemy)\n    e.scale = t.scale\n    e.ay = GRAVITY\n    placeOnFloor(e, col, row)\n    setNum(e, \"type\", typeIndex)\n    setNum(e, \"hp\", t.hp)\n    setNum(e, \"dir\", -1)\n    setNum(e, \"hurtUntil\", 0)\n    setNum(e, \"atkUntil\", 0)\n    setNum(e, \"atkReady\", 0)\n    setNum(e, \"hitAt\", 0)\n    setFlag(e, \"spotted\", false)\n    setFlag(e, \"dead\", false)\n    foesLeft++\n    if (t.boss && typeIndex == 4) boss = e\n    if (t.boss && !boss) boss = e\n}\n\nfunction spawnMouse(col: number, row: number) {\n    const m = sprites.create(MOUSE_RUN[0], SpriteKind.Food)\n    m.ay = GRAVITY\n    placeOnFloor(m, col, row)\n    setNum(m, \"dir\", 1)\n    setNum(m, \"turnAt\", 0)\n}\n\n// -----------------------------------------------------------------------------\n//  Fireheart\n// -----------------------------------------------------------------------------\nfunction onGround(s: Sprite): boolean {\n    return s.isHittingTile(CollisionDirection.Bottom)\n}\n\nfunction tryJump() {\n    if (levelBusy || !player || game.runtime() < hurtUntil) return\n    if (onGround(player)) {\n        player.vy = JUMP_SPEED\n        sfx(music.jumpUp)\n    }\n}\n\ncontroller.A.onEvent(ControllerButtonEvent.Pressed, tryJump)\ncontroller.up.onEvent(ControllerButtonEvent.Pressed, tryJump)\n\ncontroller.B.onEvent(ControllerButtonEvent.Pressed, function () {\n    const now = game.runtime()\n    if (levelBusy || !player || now < attackReady || now < hurtUntil) return\n    attackUntil = now + 270\n    attackReady = now + 340\n    const d = facing > 0 ? 0 : 1\n    setStr(player, \"anim\", \"\")\n    setAnim(player, \"attack\" + d, FIREHEART.attack[d], 90, false)\n    sfx(music.thump)\n    for (const e of sprites.allOfKind(SpriteKind.Enemy)) {\n        const dx = (e.x - player.x) * facing\n        if (dx > -8 && dx < 20 + e.width / 2 && Math.abs(e.bottom - player.bottom) < 8 + e.height / 2) {\n            hitEnemy(e)\n        }\n    }\n    for (const m of sprites.allOfKind(SpriteKind.Food)) {\n        const dx = (m.x - player.x) * facing\n        if (dx > -8 && dx < 24 && Math.abs(m.bottom - player.bottom) < 12) catchPrey(m)\n    }\n})\n\nfunction damagePlayer(fromX: number, knock: number) {\n    const now = game.runtime()\n    if (now < invulnUntil || levelBusy) return\n    info.changeLifeBy(-1)\n    invulnUntil = now + 1500\n    hurtUntil = now + 380\n    const away = player.x < fromX ? -1 : 1\n    player.vx = away * knock\n    player.vy = -130\n    scene.cameraShake(3, 250)\n    sfx(music.smallCrash)\n}\n\nfunction loseLifeAndRespawn(reason: string) {\n    if (levelBusy) return\n    info.changeLifeBy(-1)\n    player.x = safeX\n    player.y = safeY - 2\n    player.vx = 0\n    player.vy = 0\n    invulnUntil = game.runtime() + 1500\n    player.sayText(reason, 1200)\n    sfx(music.wawawawaa)\n}\n\nfunction catchPrey(m: Sprite) {\n    if (m.kind() != SpriteKind.Food) return\n    m.setKind(SpriteKind.Fallen)\n    m.destroy(effects.hearts, 200)\n    info.changeScoreBy(50)\n    if (info.life() < 9) info.changeLifeBy(1)\n    player.sayText(\"Fresh-kill!\", 800)\n    sfx(music.baDing)\n}\n\nsprites.onOverlap(SpriteKind.Player, SpriteKind.Food, function (p: Sprite, m: Sprite) {\n    catchPrey(m)\n})\n\ninfo.onLifeZero(function () {\n    game.splash(\"Fireheart has gone\", \"to join StarClan...\")\n    game.over(false)\n})\n\ngame.onUpdate(function () {\n    if (levelBusy || !player) return\n    const now = game.runtime()\n    const grounded = onGround(player)\n\n    if (now >= hurtUntil) {\n        let dir = 0\n        if (controller.left.isPressed()) dir -= 1\n        if (controller.right.isPressed()) dir += 1\n        player.vx = dir * PLAYER_SPEED\n        if (dir != 0 && now >= attackUntil) facing = dir\n    }\n    // keep Fireheart inside the map (the map edge acts like a wall he can get wedged on)\n    if (player.left < 1) { player.left = 1; if (player.vx < 0) player.vx = 0 }\n    if (player.right > mapCols * 16 - 1) { player.right = mapCols * 16 - 1; if (player.vx > 0) player.vx = 0 }\n    if (grounded && !inWater(player)) {\n        safeX = player.x\n        safeY = player.y\n    }\n\n    const d = facing > 0 ? 0 : 1\n    if (now < hurtUntil) setAnim(player, \"hurt\" + d, FIREHEART.hurt[d], 200, false)\n    else if (now < attackUntil) { /* attack animation is already playing */ }\n    else if (!grounded) setAnim(player, \"jump\" + d, FIREHEART.jump[d], 200, false)\n    else if (player.vx != 0) setAnim(player, \"walk\" + d, FIREHEART.walk[d], 90, true)\n    else setAnim(player, \"idle\" + d, FIREHEART.idle[d], 320, true)\n\n    player.setFlag(SpriteFlag.Invisible, now < invulnUntil && Math.idiv(now, 90) % 2 == 0)\n\n    if (inWater(player)) loseLifeAndRespawn(\"Splash! Too deep!\")\n    else if (fellOut(player)) loseLifeAndRespawn(\"Ow! The gorge!\")\n\n    // the level exit\n    const col = Math.floor(player.x / 16)\n    const row = Math.floor(player.y / 16)\n    if (tileIs(col, row, T_STAR_A) || tileIs(col, row, T_STAR_B)) {\n        if (foesLeft <= 0) {\n            levelBusy = true\n            control.runInParallel(levelComplete)\n        } else if (now > lockedMsgAt) {\n            lockedMsgAt = now + 2000\n            player.sayText(\"Defeat \" + foesLeft + \" more!\", 1500)\n        }\n    }\n})\n\nfunction levelComplete() {\n    player.vx = 0\n    sfx(music.powerUp)\n    effects.confetti.startScreenEffect(1500)\n    pause(1200)\n    effects.confetti.endScreenEffect()\n    info.changeScoreBy(500)\n    if (currentLevel + 1 < LEVELS.length) {\n        game.splash(\"Level complete!\", \"ThunderClan cheers you!\")\n        loadLevel(currentLevel + 1)\n    } else {\n        game.splash(\"Tigerstar is defeated!\", \"ThunderClan is safe.\")\n        game.showLongText(\"Bluestar names you Firestar, leader of ThunderClan. StarClan grants you nine lives. The forest is at peace... for now.\", DialogLayout.Center)\n        game.over(true, effects.confetti)\n    }\n}\n\n// -----------------------------------------------------------------------------\n//  Rival warriors\n// -----------------------------------------------------------------------------\nfunction hitEnemy(e: Sprite) {\n    const now = game.runtime()\n    if (now < getNum(e, \"hurtUntil\")) return\n    const hp = getNum(e, \"hp\") - 1\n    setNum(e, \"hp\", hp)\n    setNum(e, \"hurtUntil\", now + 350)\n    setNum(e, \"atkUntil\", 0)\n    setNum(e, \"dir\", -facing)\n    const t = CAT_TYPES[getNum(e, \"type\")]\n    e.vx = facing * (t.scale > 1 ? 60 : 100)\n    e.vy = -90\n    if (hp <= 0) defeatEnemy(e, \"\")\n    else sfx(music.knock)\n}\n\nfunction defeatEnemy(e: Sprite, message: string) {\n    if (getFlag(e, \"dead\")) return\n    setFlag(e, \"dead\", true)\n    const t = CAT_TYPES[getNum(e, \"type\")]\n    foesLeft--\n    info.changeScoreBy(t.points)\n    e.setKind(SpriteKind.Fallen)\n    e.setFlag(SpriteFlag.GhostThroughWalls, false)\n    if (message != \"\") e.sayText(message, 800)\n    else if (t.boss) e.sayText(\"Nooo!\", 800)\n    const d = getNum(e, \"dir\") > 0 ? 0 : 1\n    animation.runImageAnimation(e, t.skin.hurt[d], 200, false)\n    e.destroy(effects.disintegrate, 700)\n    sfx(t.boss ? music.bigCrash : music.zapped)\n    if (foesLeft == 0) player.sayText(\"Now to the StarClan star!\", 1500)\n}\n\nfunction groundAhead(e: Sprite, dir: number): boolean {\n    const col = Math.floor((e.x + dir * (e.width / 2 + 2)) / 16)\n    const row = Math.floor((e.bottom + 4) / 16)\n    return isWallAt(col, row)\n}\n\nfunction wallAhead(e: Sprite, dir: number): boolean {\n    return dir > 0 ? e.isHittingTile(CollisionDirection.Right) : e.isHittingTile(CollisionDirection.Left)\n}\n\ngame.onUpdate(function () {\n    if (levelBusy || !player) return\n    const now = game.runtime()\n    for (const e of sprites.allOfKind(SpriteKind.Enemy)) {\n        const t = CAT_TYPES[getNum(e, \"type\")]\n        let dir = getNum(e, \"dir\")\n        const grounded = onGround(e)\n        const hurt = now < getNum(e, \"hurtUntil\")\n        const attacking = now < getNum(e, \"atkUntil\")\n        const dx = player.x - e.x\n        const dy = player.bottom - e.bottom\n        const sees = Math.abs(dx) < t.sight && Math.abs(dy) < 40 * t.scale && now >= invulnUntil - 1000\n\n        if (inWater(e)) { defeatEnemy(e, \"Swept away!\"); continue }\n        if (fellOut(e)) { defeatEnemy(e, \"Aaah!\"); continue }\n\n        // the claw strike lands part-way through the attack animation\n        const hitAt = getNum(e, \"hitAt\")\n        if (hitAt > 0 && now >= hitAt) {\n            setNum(e, \"hitAt\", 0)\n            const reach = (player.x - e.x) * dir\n            if (!hurt && reach > -6 && reach < e.width / 2 + 16 && Math.abs(dy) < 12 * t.scale) {\n                damagePlayer(e.x, t.scale > 1 ? 160 : 110)\n            }\n        }\n\n        if (hurt) {\n            e.vx = e.vx * 0.9\n        } else if (attacking) {\n            e.vx = 0\n        } else if (grounded) {\n            if (sees) {\n                if (!getFlag(e, \"spotted\")) {\n                    setFlag(e, \"spotted\", true)\n                    e.sayText(t.boss ? \"Fireheart! You'll pay!\" : t.clan + \"!\", 900)\n                }\n                dir = dx > 0 ? 1 : -1\n                const close = Math.abs(dx) < e.width / 2 + 14 && Math.abs(dy) < 12 * t.scale\n                if (close && now >= getNum(e, \"atkReady\")) {\n                    setNum(e, \"atkUntil\", now + 300)\n                    setNum(e, \"atkReady\", now + t.cooldown)\n                    setNum(e, \"hitAt\", now + 150)\n                    const d0 = dir > 0 ? 0 : 1\n                    setStr(e, \"anim\", \"\")\n                    setAnim(e, \"attack\" + d0, t.skin.attack[d0], 100, false)\n                    e.vx = 0\n                } else if (close) {\n                    e.vx = 0\n                } else if (!groundAhead(e, dir)) {\n                    e.vx = 0  // don't chase off a ledge\n                } else {\n                    e.vx = dir * t.chaseSpeed\n                    // pounce!\n                    const far = Math.abs(dx)\n                    if (far > 30 && far < 80 && Math.percentChance(t.boss ? 3 : 1)) {\n                        e.vy = t.boss ? -200 : -170\n                        e.vx = dir * t.chaseSpeed * 1.6\n                    }\n                }\n            } else {\n                if (wallAhead(e, dir) || !groundAhead(e, dir)) dir = -dir\n                e.vx = dir * t.speed\n            }\n        }\n        setNum(e, \"dir\", dir)\n\n        const d = dir > 0 ? 0 : 1\n        if (hurt) setAnim(e, \"hurt\" + d, t.skin.hurt[d], 200, false)\n        else if (attacking) { /* attack animation already running */ }\n        else if (!grounded) setAnim(e, \"jump\" + d, t.skin.jump[d], 200, false)\n        else if (e.vx != 0) setAnim(e, \"walk\" + d, t.skin.walk[d], Math.abs(e.vx) > 45 ? 90 : 140, true)\n        else setAnim(e, \"idle\" + d, t.skin.idle[d], 320, true)\n    }\n\n    // prey: wander, and flee from Fireheart\n    for (const m of sprites.allOfKind(SpriteKind.Food)) {\n        let dir = getNum(m, \"dir\")\n        const dx = m.x - player.x\n        let speed = 20\n        if (Math.abs(dx) < 50 && Math.abs(m.y - player.y) < 30) {\n            dir = dx > 0 ? 1 : -1\n            speed = 55\n        } else if (now > getNum(m, \"turnAt\")) {\n            setNum(m, \"turnAt\", now + 800 + randint(0, 1500))\n            dir = Math.percentChance(50) ? 1 : -1\n        }\n        if (wallAhead(m, dir) || !groundAhead(m, dir)) {\n            dir = -dir\n        }\n        if (inWater(m) || fellOut(m)) { m.destroy(); continue }\n        m.vx = onGround(m) ? dir * speed : m.vx\n        setNum(m, \"dir\", dir)\n        setAnim(m, \"run\" + dir, MOUSE_FRAMES[dir > 0 ? 0 : 1], speed > 30 ? 80 : 160, true)\n    }\n})\n\n// -----------------------------------------------------------------------------\n//  Thunderpath monsters\n// -----------------------------------------------------------------------------\nconst MONSTER_COLORS = [0xa, 0x2, 0x8, 0x7, 0x1, 0x5]\n\nfunction spawnMonster(dir: number) {\n    const L = LEVELS[currentLevel]\n    const color = MONSTER_COLORS[randint(0, MONSTER_COLORS.length - 1)]\n    const map: number[] = []\n    for (let i = 0; i < 16; i++) map.push(i)\n    map[0xa] = color\n    let frames = MONSTER_DRIVE.map(function (f: Image) { return recolor(f, map) })\n    if (dir > 0) frames = mirrored(frames)\n    const m = sprites.create(frames[0], SpriteKind.Monster)\n    m.setFlag(SpriteFlag.GhostThroughWalls, true)\n    m.z = 20\n    const left = scene.cameraProperty(CameraProperty.Left)\n    if (dir < 0) m.left = left + 164\n    else m.right = left - 4\n    m.bottom = L.roadRow * 16 + 1\n    m.vx = dir * randint(150, 190)\n    m.lifespan = 3200\n    animation.runImageAnimation(m, frames, 70, true)\n    sfx(music.zapped)\n}\n\ngame.onUpdate(function () {\n    if (levelBusy || !player) return\n    const L = LEVELS[currentLevel]\n    if (L.roadTo == 0) return\n    const now = game.runtime()\n    const col = player.x / 16\n    if (col < L.roadFrom - 2 || col > L.roadTo + 2) {\n        nextMonster = 0\n        return\n    }\n    if (nextMonster == 0) nextMonster = now + randint(1500, 2500)\n    if (!monsterWarned && now > nextMonster - 900) {\n        monsterWarned = true\n        monsterDir = Math.percentChance(70) ? -1 : 1\n        const w = sprites.create(WARNING_SIGN[0], SpriteKind.Warning)\n        w.setFlag(SpriteFlag.RelativeToCamera, true)\n        w.setPosition(monsterDir < 0 ? 148 : 12, 60)\n        w.lifespan = 900\n        animation.runImageAnimation(w, WARNING_SIGN, 120, true)\n        music.play(music.tonePlayable(196, music.beat(BeatFraction.Quarter)), music.PlaybackMode.InBackground)\n    }\n    if (now > nextMonster) {\n        spawnMonster(monsterDir)\n        nextMonster = now + randint(2600, 4500)\n        monsterWarned = false\n    }\n})\n\nsprites.onOverlap(SpriteKind.Player, SpriteKind.Monster, function (p: Sprite, m: Sprite) {\n    if (game.runtime() < invulnUntil) return\n    player.sayText(\"Monster!\", 800)\n    damagePlayer(m.x, 170)\n})\n\nsprites.onOverlap(SpriteKind.Enemy, SpriteKind.Monster, function (e: Sprite, m: Sprite) {\n    defeatEnemy(e, \"Monster!\")\n})\n\n// -----------------------------------------------------------------------------\n//  Animated tiles: the river ripples and StarClan stars twinkle\n// -----------------------------------------------------------------------------\nlet tileFrame = 0\ngame.onUpdateInterval(450, function () {\n    if (levelBusy) return\n    tileFrame = 1 - tileFrame\n    const fromW = tileFrame ? T_WATER_A : T_WATER_B\n    const toW = tileFrame ? T_WATER_B : T_WATER_A\n    for (const loc of tiles.getTilesByType(fromW)) tiles.setTileAt(loc, toW)\n    const fromS = tileFrame ? T_STAR_A : T_STAR_B\n    const toS = tileFrame ? T_STAR_B : T_STAR_A\n    for (const loc of tiles.getTilesByType(fromS)) tiles.setTileAt(loc, toS)\n})\n\n// -----------------------------------------------------------------------------\n//  Start!\n// -----------------------------------------------------------------------------\ninfo.setLife(5)\ninfo.setScore(0)\nscene.setBackgroundColor(15)\ngame.splash(\"WARRIORS\", \"Fireheart's Quest\")\ngame.showLongText(\"Left/Right: run\\nA: jump\\nB: claw attack\\n\\nDefeat the rival warriors, then reach the StarClan star. Catch mice to heal!\", DialogLayout.Center)\nloadLevel(0)\n","README.md":" ","assets.json":"","pxt.json":"{\n    \"name\": \"The Warriors\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"device\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"assets.json\"\n    ],\n    \"preferredEditor\": \"tsprj\"\n}\n"}},{"timestamp":1791933382356,"editorVersion":"4.1.25","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable type=\"KIND_SpriteKind\" id=\"1U?,=GjZl;#cY1Lw~817\">Monster</variable><variable type=\"KIND_SpriteKind\" id=\"q9d0$XAf6GTVXUo_!;V4\">Fallen</variable><variable type=\"KIND_SpriteKind\" id=\"B;/6Md@D`L!3y~IC9^B0\">Warning</variable><variable type=\"KIND_SpriteKind\" id=\"?rT~`:${+laJ*tOE$;6p\">Player</variable><variable type=\"KIND_SpriteKind\" id=\"+NXoI/5/=Su+2%l_FoNO\">Projectile</variable><variable type=\"KIND_SpriteKind\" id=\"*QuJH{RZYigbb=H;]hFB\">Food</variable><variable type=\"KIND_SpriteKind\" id=\"?BL=k/a1tlOOuW]qniyB\">Enemy</variable><variable id=\".=sYPyxyY7uq:p+{SJaE\">out</variable><variable id=\"Vg},MT(fdGaEbW]~ARoD\">x</variable><variable id=\"`Ef_ErTk6,$o2{CFf]%B\">y</variable><variable id=\"TfvM9Y?iv;=M9%1g0_Z+\">c</variable><variable id=\"^hQ(SS5BNi(Kd/{d$FSU\">right</variable><variable id=\"#]U;1#BzsFg(@o=l{eO7\">list</variable><variable id=\"h~aGyqIrP%km|M8}^InR\">i</variable><variable id=\"3L!7J#Dz9/)0@ljd-rXR\">map</variable><variable id=\"/zhu-9cw?Bej|!I1SgaA\">s</variable><variable id=\"ltYRL2;1}jHMh}{qOP,i\">l</variable><variable id=\"U5!g!ILqX,W-yWH[~Ch,\">TRANSPARENT_TILE</variable><variable id=\"ndpD5}e%Vt}Un36|szj;\">v</variable><variable id=\"v[9kYicHO1+C$j)M!(N+\">w</variable><variable id=\"FElx5Kb.2Omd~u:T}tv!\">mySprite</variable><variable id=\"#0Iz0S^|fvK#tzltFlha\">mapCols</variable><variable id=\"ax?-9w)x9M_/m,uwj@76\">mapRows</variable><variable id=\"ktxC9n0r}#|Omef(/xd