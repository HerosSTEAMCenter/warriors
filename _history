pe=\"math_number\"><field name=\"NUM\">150</field></shadow></value><value name=\"limit\"><shadow type=\"math_number\"><field name=\"NUM\">190</field></shadow></value></block></value></block></value><next><block type=\"Sprite_blockCombine_set\"><field name=\"property\">Sprite.lifespan</field><value name=\"mySprite\"><block type=\"variables_get\"><field name=\"VAR\" id=\"DHF:/dpa?BjaasHy6mo3\">m4</field></block></value><value name=\"value\"><shadow type=\"math_number\"><field name=\"NUM\">3200</field></shadow></value><next><block type=\"run_image_animation\"><value name=\"sprite\"><block type=\"variables_get\"><field name=\"VAR\" id=\"DHF:/dpa?BjaasHy6mo3\">m4</field></block></value><value name=\"frames\"><shadow type=\"animation_editor\"><field name=\"frames\">[]</field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\";E#2$qdNPi/}pOVWA07Y\">frames</field></block></value><value name=\"frameInterval\"><shadow type=\"timePicker\"><field name=\"ms\">70</field></shadow></value><value name=\"loop\"><shadow type=\"toggleOnOff\"><field name=\"on\">true</field></shadow></value><next><block type=\"typescript_statement\"><mutation xmlns=\"http://www.w3.org/1999/xhtml\" line0=\"sfx(music.zapped)\" numlines=\"1\"></mutation></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block></xml>","main.ts":"namespace SpriteKind {\n    export const Monster = SpriteKind.create()\n    export const Fallen = SpriteKind.create()\n    export const Warning = SpriteKind.create()\n}\nfunction getStr (s: Sprite, key: string) {\n    w = s.data[0]\n    return w ? w : \"\"\n}\nfunction wallAhead (e: Sprite, dir: number) {\n    return dir > 0 ? e.isHittingTile(CollisionDirection.Right) : e.isHittingTile(CollisionDirection.Left)\n}\nfunction getFlag (s: Sprite, key: string) {\n    return !(!(s.data[0]))\n}\nfunction setStr (s: Sprite, key: string, v: string) {\n    s.data[0] = v\n}\nfunction spawnMonster (dir: number) {\n    L3 = LEVELS[currentLevel]\n    color = MONSTER_COLORS[randint(0, MONSTER_COLORS.length - 1)]\n    for (let i2 = 0; i2 <= 15; i2++) {\n        map2.push(i2)\n    }\n    map2[10] = color\n    let frames = MONSTER_DRIVE.map(function (f: Image) { return recolor(f, map2) })\nif (dir > 0) {\n        frames = mirrored(frames)\n    }\n    m4 = sprites.create(frames[0], SpriteKind.Monster)\n    m4.setFlag(SpriteFlag.GhostThroughWalls, true)\n    m4.z = 20\n    left2 = scene.cameraProperty(CameraProperty.Left)\n    if (dir < 0) {\n        m4.left = left2 + 164\n    } else {\n        m4.right = left2 - 4\n    }\n    m4.bottom = L3.roadRow * 16 + 1\n    m4.vx = dir * randint(150, 190)\n    m4.lifespan = 3200\n    animation.runImageAnimation(\n    m4,\n    frames,\n    70,\n    true\n    )\n    sfx(music.zapped)\n}\nfunction groundAhead (e: Sprite, dir: number) {\n    col3 = Math.floor((e.x + dir * (e.width / 2 + 2)) / 16)\n    row5 = Math.floor((e.bottom + 4) / 16)\n    return isWallAt(col3, row5)\n}\nfunction isWallAt (col: number, row: number) {\n    if (col < 0 || col >= mapCols) {\n        return true\n    }\n    if (row < 0 || row >= mapRows) {\n        return false\n    }\n    return tiles.tileAtLocationIsWall(tiles.getTileLocation(col, row))\n}\nfunction recolor (src: Image, map: number[]) {\n    out = src.clone()\n    for (let x = 0; x <= out.width - 1; x++) {\n        for (let y = 0; y <= out.height - 1; y++) {\n            c = out.getPixel(x, y)\n            if (c != 0) {\n                out.setPixel(x, y, map[c])\n            }\n        }\n    }\n    return out\n}\nfunction fellOut (s: Sprite) {\n    return s.bottom >= mapRows * 16 - 2\n}\ncontroller.B.onEvent(ControllerButtonEvent.Pressed, function () {\n    now = game.runtime()\n    if (levelBusy || !(player2) || now < attackReady || now < hurtUntil) {\n        return\n    }\n    attackUntil = now + 270\n    attackReady = now + 340\n    const d2 = facing > 0 ? 0 : 1\nsetStr(player2, \"anim\", \"\")\n    setAnim(player2, \"attack\" + d2, FIREHEART.attack[d2], 90, false)\n    sfx(music.thump)\nfor (let e2 of sprites.allOfKind(SpriteKind.Enemy)) {\n        dx = (e2.x - player2.x) * facing\n        if (dx > -8 && dx < 20 + e2.width / 2 && Math.abs(e2.bottom - player2.bottom) < 8 + e2.height / 2) {\n            hitEnemy(e2)\n        }\n    }\n    for (let m2 of sprites.allOfKind(SpriteKind.Food)) {\n        dx2 = (m2.x - player2.x) * facing\n        if (dx2 > -8 && dx2 < 24 && Math.abs(m2.bottom - player2.bottom) < 12) {\n            catchPrey(m2)\n        }\n    }\n})\nfunction buildBackground (theme: number) {\n    rngSeed = 7 + theme * 31\n    farLayer = image.create(160, 120)\n    nearLayer = image.create(160, 120)\n    if (theme == 0) {\n        // forest day: clouds + green treeline\n        scene.setBackgroundColor(9)\n        for (let index = 0; index < 6; index++) {\n            x2 = rand(160)\n            y2 = 10 + rand(30)\n            wrapCircle(farLayer, x2, y2, 6 + rand(4), 1)\n            wrapCircle(farLayer, x2 + 8, y2 + 2, 5 + rand(3), 1)\n            wrapCircle(farLayer, x2 - 7, y2 + 3, 4, 1)\n        }\n        for (let x3 = 0; x3 < 160; x3 += 9) wrapCircle(nearLayer, x3, 70 + rand(10), 10 + rand(5), 6)\nnearLayer.fillRect(0, 78, 160, 42, 6)\n    } else if (theme == 1) {\n        // moor: clouds + rolling hills\n        scene.setBackgroundColor(9)\n        for (let index = 0; index < 5; index++) {\n            x4 = rand(160)\n            y3 = 8 + rand(25)\n            wrapCircle(farLayer, x4, y3, 5 + rand(4), 1)\n            wrapCircle(farLayer, x4 + 7, y3 + 1, 4 + rand(3), 1)\n        }\n        for (let x5 = 0; x5 <= 159; x5++) {\n            h = 70 + Math.round(8 * Math.sin(x5 * Math.PI / 40) + 4 * Math.sin(x5 * Math.PI / 16))\n            nearLayer.drawLine(x5, h, x5, 119, 6)\n            if (h + 3 < 120) {\n                nearLayer.setPixel(x5, h + 3 + x5 % 3, 7)\n            }\n        }\n    } else if (theme == 2) {\n        // Thunderpath at dusk: sun, Twoleg buildings\n        scene.setBackgroundColor(3)\n        farLayer.fillRect(0, 0, 160, 25, 10)\n        farLayer.fillRect(0, 25, 160, 15, 11)\n        farLayer.fillCircle(120, 58, 16, 5)\nfarLayer.fillCircle(120, 58, 11, 4)\nwhile (x6 < 160) {\n            a = 12 + rand(14)\n            o = 25 + rand(30)\n            nearLayer.fillRect(x6, 95 - o, a, o + 25, 12)\n            for (let wy = 95 - o + 4; wy < 90; wy += 7) {\n                for (let wx = x6 + 3; wx < x6 + a - 3; wx += 5) {\n                    if (rand(3) == 0) nearLayer.fillRect(wx, wy, 2, 3, 5)\n                }\n            }\nx6 += a + 2 + rand(8)\n        }\n    } else {\n        // ShadowClan night: stars, moon, pines\n        scene.setBackgroundColor(15)\n        for (let index = 0; index < 40; index++) {\n            farLayer.setPixel(rand(160), rand(70), rand(4) == 0 ? 5 : 1)\n        }\n        farLayer.fillCircle(40, 25, 10, 1)\nfarLayer.fillCircle(44, 22, 9, 15)\nfor (let x7 = 0; x7 < 160; x7 += 11) pine(nearLayer, x7 + rand(5), 85 + rand(8), 30 + rand(25), 0xc)\n    }\n}\nfunction wrapCircle (img2: Image, x: number, y: number, r: number, c: number) {\n    img.fillCircle(x, y, r, c)\nimg.fillCircle(x - img.width, y, r, c)\nimg.fillCircle(x + img.width, y, r, c)\n}\nfunction tileIs (col: number, row: number, t: Image) {\n    if (col < 0 || row < 0 || col >= mapCols || row >= mapRows) {\n        return false\n    }\n    return tiles.tileAtLocationEquals(tiles.getTileLocation(col, row), t)\n}\nfunction level (name: string, story: string, theme: number, map: any[], roadFrom: number, roadTo: number, roadRow: number) {\n    const l = new Level()\nl.name = name;\nl.story = story;\nl.theme = theme;\nl.map = map\nl.roadFrom = roadFrom;\nl.roadTo = roadTo;\nl.roadRow = roadRow\nreturn l\n}\nfunction spawnMouse (col: number, row: number) {\n    g = sprites.create(MOUSE_RUN[0], SpriteKind.Food)\n    g.ay = GRAVITY\n    placeOnFloor(g, col, row)\n    setNum(g, \"dir\", 1)\n    setNum(g, \"turnAt\", 0)\n}\nfunction defeatEnemy (e: Sprite, message: string) {\n    if (getFlag(e, \"dead\")) {\n        return\n    }\n    setFlag(e, \"dead\", true)\n    t3 = CAT_TYPES[getNum(e, \"type\")]\n    foesLeft += -1\n    info.changeScoreBy(t3.points)\n    e.setKind(SpriteKind.Fallen)\n    e.setFlag(SpriteFlag.GhostThroughWalls, false)\n    if (message != \"\") {\n        e.sayText(message, 800)\n    } else if (t3.boss) {\n        e.sayText(\"Nooo!\", 800)\n    }\n    const d4 = getNum(e, \"dir\") > 0 ? 0 : 1\nanimation.runImageAnimation(\n    e,\n    t3.skin.hurt[d4],\n    200,\n    false\n    )\n    e.destroy(effects.disintegrate, 700)\n    sfx(t3.boss ? music.bigCrash : music.zapped)\nif (foesLeft == 0) {\n        player2.sayText(\"Now to the StarClan star!\", 1500)\n    }\n}\nfunction rand (n: number) {\n    rngSeed = (rngSeed * 1103515245 + 12345) & 0x7fffffff\nreturn rngSeed % n\n}\nfunction damagePlayer (fromX: number, knock: number) {\n    now2 = game.runtime()\n    if (now2 < invulnUntil || levelBusy) {\n        return\n    }\n    info.changeLifeBy(-1)\n    invulnUntil = now2 + 1500\n    hurtUntil = now2 + 380\n    const away = player.x < fromX ? -1 : 1\nplayer2.vx = away * knock\n    player2.vy = -130\n    scene.cameraShake(3, 250)\n    sfx(music.smallCrash)\n}\nfunction setFlag (s: Sprite, key: string, v: boolean) {\n    s.data[0] = v\n}\nfunction pine (img2: Image, x: number, base: number, h: number, c: number) {\n    for (let j = 0; j <= h - 1; j++) {\n        half = Math.idiv(j, 2) + 1\n        for (let ox of [0, 0 - img.width, img.width]) {\n            img2.drawLine(x + ox - half, base - h + j, x + ox + half, base - h + j, c)\n        }\n    }\n    img2.fillRect(x - 1, base, 3, img.height - base, c)\n}\n// Small helpers for storing per-sprite values\nfunction getNum (s: Sprite, key: string) {\n    v = s.data[0]\n    return v ? v